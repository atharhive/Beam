# ==========================================
# Beam — Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Node Environment (development | production | test)
NODE_ENV=development

# Vybe Network API Key (Get a free key at https://vybe.fyi/api-pricing)
VYBE_API_KEY=your_vybe_api_key_here
VYBE_DATA_API_KEY=your_vybe_api_key_here

# Optional: Vybe API Base URL (default: https://api.vybenetwork.xyz)
# VYBE_API_BASE=https://api.vybenetwork.xyz

# Solana RPC Configuration (Priority: SOLANA_RPC_URL -> HELIUS_API_KEY -> Public Mainnet)
# Recommended for production: Helius, Triton, QuickNode, or Alchemy
# HELIUS_API_KEY=your_helius_api_key_here
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
