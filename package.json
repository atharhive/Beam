{
  "name": "beam",
  "version": "1.0.0",
  "description": "Beam — Pay with anything. Settle in USDC on Solana.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "rm -rf node_modules/bigint-buffer/build 2>/dev/null || true"
  },
  "keywords": [
    "solana",
    "payments",
    "usdc",
    "beam",
    "swap",
    "web3",
    "defi"
  ],
  "author": "atharhive",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "1.98.4",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nanoid": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "bun-types": "latest",
    "typescript": "^5.7.3"
  }
}
